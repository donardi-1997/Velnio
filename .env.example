APP_NAME=Velnio
APP_ENV=development

DATABASE_URL=postgresql+asyncpg://velnio:velnio@postgres:5432/velnio
DATABASE_URL_SYNC=postgresql+psycopg2://velnio:velnio@postgres:5432/velnio

JWT_SECRET=change-me-in-production-use-a-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

ENCRYPTION_KEY=change-me-in-production-use-a-random-key

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SHOPIFY_MODE=mock
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/shopify/callback
SHOPIFY_API_VERSION=2024-10

BILLING_PROVIDER=mock

FRONTEND_URL=http://localhost:5173

POSTGRES_USER=velnio
POSTGRES_PASSWORD=velnio
POSTGRES_DB=velnio
