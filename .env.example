APP_NAME=Velnio
APP_ENV=development

DATABASE_URL=postgresql+asyncpg://velnio:velnio@postgres:5432/velnio
DATABASE_URL_SYNC=postgresql+psycopg2://velnio:velnio@postgres:5432/velnio

JWT_SECRET=change-me-in-production-use-a-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

ENCRYPTION_KEY=change-me-in-production-use-a-random-key

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=30

SHOPIFY_MODE=mock
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,write_online_store_pages
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/stores/shopify/callback
SHOPIFY_API_VERSION=2026-07
SHOPIFY_REQUEST_TIMEOUT_SECONDS=15

BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_TRIAL_DAYS=7
STRIPE_REQUEST_TIMEOUT_SECONDS=20

GOOGLE_DRIVE_MODE=mock
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/google-drive/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_MAX_FILE_MB=25

FRONTEND_URL=http://localhost:5173

POSTGRES_USER=velnio
POSTGRES_PASSWORD=velnio
POSTGRES_DB=velnio
